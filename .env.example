# Токен бота от @BotFather (обязателен). В @BotFather включить Secretary Mode (бывший Business Mode).
BOT_TOKEN=
# Telegram id владельца. Пусто: владельцем станет первый, кто подключит бота в Telegram Business,
# дальше только он. Надёжнее вписать сразу.
OWNER_ID=
# Провайдер ИИ: anthropic или openai
LLM_PROVIDER=anthropic
# Пусто: anthropic -> claude-sonnet-5-5, openai -> gpt-5.4-mini
LLM_MODEL=
# Глубина рассуждения модели: low, medium, high, xhigh, max или none (не передавать)
LLM_EFFORT=low
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Расшифровка голосовых клиента: none или openai (нужен OPENAI_API_KEY)
STT_PROVIDER=none
STT_MODEL=gpt-4o-mini-transcribe
# Лимиты ответов ИИ за сутки
AI_CHAT_DAILY_LIMIT=12
AI_DAILY_LIMIT=150
DATA_DIR=/app/data
TZ=Asia/Tashkent
